# Pendacare Environment Variables — Example / Template
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or any file containing real secrets to source control.

# ---------------------------------------------------------------------------
# App URL (used for password-reset email redirects)
# ---------------------------------------------------------------------------
# Local development:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Production:
NEXT_PUBLIC_SITE_URL=https://pendacare-fawn.vercel.app

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# In Supabase Dashboard → Authentication → URL Configuration, add redirect URLs:
#   http://localhost:3000/reset-password
#   http://localhost:3000/auth/callback  (optional, OAuth / other flows)
#   https://pendacare-fawn.vercel.app/reset-password
#   https://pendacare-fawn.vercel.app/auth/callback  (optional, OAuth / other flows)
# Password reset PKCE: see docs/password-reset-email.md


# Supabase project URL (from your Supabase project settings → API)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# Supabase anonymous/public key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key (server-side only — NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# Encryption
# ---------------------------------------------------------------------------

# AES-256-GCM encryption key: base64-encoded 256-bit (32-byte) key
# Used to encrypt health_info and message content at the application layer.
# Generate a new key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=your-base64-encoded-256-bit-aes-key

# ---------------------------------------------------------------------------
# Custom SMTP (Supabase Auth — not used by Next.js directly)
# Used by: npm run smtp:configure  (see docs/custom-smtp.md)
# Recommended provider: Resend — https://resend.com/docs/send-with-supabase-smtp
# ---------------------------------------------------------------------------

# Personal access token: https://supabase.com/dashboard/account/tokens
# (you may already have this as SUPABASE_ACCESS_TOKEN)
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# Optional if NEXT_PUBLIC_SUPABASE_URL is set (auto-detected from URL)
# SUPABASE_PROJECT_REF=ywtucabytahpgxznfcef

# Resend example:
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SMTP_ADMIN_EMAIL=onboarding@resend.dev
SMTP_SENDER_NAME=Pendacare

# Optional: emails per hour after custom SMTP (raise in dashboard too)
# RATE_LIMIT_EMAIL_SENT=100

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------

# Bearer token used to authenticate Vercel Cron job requests to /api/cron/*
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-cron-secret
